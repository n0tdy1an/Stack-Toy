import os
#The color for the rings
colors = {
    "red": ("\033[31m|-----RED-----|\033[0m"),
    "orange":("\033[38;2;255;165;0m|----ORANGE----|\033[0m"),
    "yellow":("\033[33m|---YELLOW---|\033[0m"),
    "green":("\033[32m|--GREEN--|\033[0m"),
    "blue":("\033[34m|-BLUE-|\033[0m"),
}
stack = []
#Repeats the code
while True:

    userInput = input("Type 1 to add a ring, 2 to remove a ring, type 3 to exit: ")
    #If the user inputs 1, then it allows the user to add their desired ring.
    if userInput == "1":
        rings = input("Add color (red, orange, yellow, green, blue): ")
        if rings in colors:
            stack.append(rings)
            print([rings])
            os.system('cls')
        else:
            print("Invalid color.")
#If the user inputs 2, then they can remove rings
    elif userInput == "2":
        if not stack:
            os.system('cls')
            print("Stack is empty.")
            continue

        rings = input("Remove color (red, orange, yellow, green, blue): ")
        if rings != stack[-1]:
            print(f"Top ring is {stack[-1]}, must remove it first to get to your desired ring")
            continue
        os.system('cls')
        stack.pop()
        print(f"Removed {rings} ring.")

    #If the user inputs 3, it makes the user exit the program.
    elif userInput == "3":
        print("Goodbye!")
        break

    else:
        print("Invalid choice.")
#Shows the current stack 
    if stack:
        print("Current stack:")
        for rings in reversed(stack):
            print(colors[rings])
